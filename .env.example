# ============================================================================
# Padmakosh School of Kathak — Environment Configuration Example
# Copy to .env for local overrides. NEVER commit real secrets to version control.
# ============================================================================

# Build & Content Mode:
# - "local-review": Uses clearly labelled local fixtures, renders verification badges,
#   enables noindex, and uses the local enquiry delivery stub.
# - "production": Requires live Sanity credentials, suppresses all unapproved/placeholder
#   content, and fails loudly if Sanity is unreachable (never falls back to mock data).
PUBLIC_CONTENT_MODE=local-review

# Canonical Site Origin (used for canonical URLs, Open Graph, and sitemap)
PUBLIC_SITE_URL=https://padmakoshstudio.in

# Search Engine Indexing Gate ("true" only when authorised for public launch)
PUBLIC_ALLOW_INDEXING=false

# Sanity CMS Configuration (populate only when authorised Sanity project/dataset exist)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-02-01
PUBLIC_SANITY_STUDIO_URL=

# Server-Only Secrets (NEVER prefix with PUBLIC_)
# Used only when server-rendered/hybrid adapter is enabled in an authorised environment:
SANITY_WEBHOOK_SECRET=
ENQUIRY_DELIVERY_MODE=local-stub
ENQUIRY_RECIPIENT_EMAIL=sonalpatil286@gmail.com
ENQUIRY_PROVIDER_API_KEY=
SCHEDULED_REBUILD_TRIGGER_SECRET=
