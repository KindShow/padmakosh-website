---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/about/', label: 'ABOUT' },
  { href: '/classes/', label: 'PROGRAMS' },
  { href: '/sonal-pendse/', label: 'SONAL PENDSE' },
  { href: '/studio/', label: 'STUDIO' },
  { href: '/events/', label: 'EVENTS' },
  { href: '/gallery/', label: 'GALLERY' },
  { href: '/contact/', label: 'CONTACT' },
];
---

<header class="sleek-header">
  <div class="container header-inner">
    <!-- Logo Brand -->
    <a href="/" class="brand-link" aria-label="Padmakosh School of Kathak, Pune — Home">
      <img
        src="/images/logo/padmakosh_emblem_transparent.png"
        alt="Padmakosh Kathak Dancer Logo Emblem"
        class="brand-emblem-img"
        width="48"
        height="52"
      />
      <div class="brand-text-block">
        <img
          src="/images/logo/padmakosh_pristine_wordmark.png"
          alt="Padmakosh"
          class="brand-calligraphic-wordmark"
          width="165"
          height="31"
        />
        <span class="brand-sub">
          SCHOOL OF KATHAK <span class="sub-sep">·</span> PUNE
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="main-nav">
      <ul class="nav-list">
        {
          navLinks.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`nav-anchor ${isActive ? 'nav-anchor--active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Right Actions: Desktop Enquire + Mobile Hamburger Toggle -->
    <div class="header-action">
      <a href="/contact/" class="header-cta-btn">
        ENQUIRE
      </a>

      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-btn"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" aria-label="Mobile Navigation" hidden>
    <div class="container mobile-drawer-inner">
      <ul class="mobile-nav-list">
        <li>
          <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'mobile-nav-link--active' : ''}`}>
            HOME
          </a>
        </li>
        {
          navLinks.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav-link ${isActive ? 'mobile-nav-link--active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mobile-drawer-footer">
        <a href="/contact/" class="btn btn--maroon" style="width: 100%; justify-content: center;">
          ENQUIRE FOR CLASSES OR STUDIO
        </a>
        <div class="mobile-quick-contact">
          <a href="tel:+919689615339">Call: +91 96896 15339</a>
          <span>·</span>
          <a href="mailto:sonalpatil286@gmail.com">sonalpatil286@gmail.com</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileNav() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        drawer.setAttribute('hidden', '');
      } else {
        drawer.removeAttribute('hidden');
      }
    });
  }

  setupMobileNav();
  document.addEventListener('astro:page-load', setupMobileNav);
</script>

<style>
  .sleek-header {
    background-color: #ffffff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 1rem;
  }

  .brand-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    line-height: 1.1;
    flex-shrink: 0;
  }

  .brand-emblem-img {
    height: 48px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.08));
    transition: transform 0.3s ease;
  }

  .brand-link:hover .brand-emblem-img {
    transform: scale(1.05) rotate(2deg);
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-calligraphic-wordmark {
    height: 31px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
    display: block;
    margin-bottom: 3px;
    filter: contrast(1.1);
  }

  .brand-sub {
    font-family: var(--font-display);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: #6d1b28;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .brand-sub .sub-sep {
    color: var(--gold-dark);
    font-weight: 700;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-anchor {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: #3b3637;
    text-decoration: none;
    padding-block: 0.5rem;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-anchor:hover {
    color: var(--maroon-rich);
  }

  .nav-anchor--active {
    color: var(--maroon-rich);
  }

  .nav-anchor--active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1.5px;
    background-color: var(--maroon-rich);
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .header-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    padding: 0.65rem 1.45rem;
    background-color: var(--maroon-rich);
    color: #ffffff;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .header-cta-btn:hover {
    background-color: var(--maroon-hover);
    transform: translateY(-1px);
  }

  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(109, 27, 40, 0.2);
    background: #faf8f5;
    color: var(--maroon-rich);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background: #f3ece2;
    border-color: var(--maroon-rich);
  }

  .mobile-menu-toggle .icon-close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  .mobile-nav-drawer {
    background: #ffffff;
    border-bottom: 2px solid var(--gold-warm);
    box-shadow: 0 18px 35px -10px rgba(0, 0, 0, 0.12);
  }

  .mobile-drawer-inner {
    padding-block: 1.25rem 1.75rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0 0 1.25rem 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-light);
    text-decoration: none;
  }

  .mobile-nav-link--active {
    color: var(--maroon-rich);
    background: rgba(109, 27, 40, 0.04);
    padding-left: 0.85rem;
    border-left: 3px solid var(--maroon-rich);
  }

  .mobile-drawer-footer {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .mobile-quick-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .mobile-quick-contact a {
    color: var(--maroon-rich);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 1080px) {
    .nav-list {
      gap: 1.15rem;
    }
  }

  @media (max-width: 900px) {
    .main-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      height: 68px;
    }

    .brand-emblem-img {
      height: 40px;
    }

    .brand-calligraphic-wordmark {
      height: 25px;
      max-width: 135px;
    }

    .brand-sub {
      font-size: 0.62rem;
      letter-spacing: 0.12em;
    }

    .header-cta-btn {
      padding: 0.55rem 0.9rem;
      font-size: 0.66rem;
      letter-spacing: 0.12em;
    }
  }
</style>
