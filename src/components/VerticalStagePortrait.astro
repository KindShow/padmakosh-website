---
import type { ReusableMediaItem } from '../types/content';
import EvidenceBadge from './EvidenceBadge.astro';

interface Props {
  media: ReusableMediaItem;
  contextLabel?: string;
}

const { media, contextLabel = 'Editorial Stage Portrait Frame' } = Astro.props;
---

<figure class="editorial-portrait-wrapper" style="margin: 0;">
  <div class="editorial-portrait-frame" role="img" aria-label={media.altText.value}>
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-gold-300); font-weight: 700;">
        {contextLabel} · 3:4 Vertical
      </span>
      <span class="evidence-badge evidence-badge--supplied" style="font-size: 0.68rem;">
        {media.filename} ({Math.round((media.bytes || 0) / 1024)} KB)
      </span>
    </div>

    <div class="editorial-portrait-frame__silhouette">
      <!-- Visual representation of the teal & gold vertical stage composition in KAU_0072.JPG -->
      <svg
        width="88"
        height="136"
        viewBox="0 0 88 136"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        style="margin-bottom: 1rem; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.45));"
      >
        <circle cx="44" cy="20" r="10" stroke="#E3C88D" stroke-width="2" fill="#1B5E67" />
        <path
          d="M20 46C28 36 60 36 68 46L58 84L72 120H16L30 84L20 46Z"
          fill="#1B5E67"
          stroke="#E3C88D"
          stroke-width="2"
        />
        <path d="M36 38L52 84L44 120" stroke="#C49746" stroke-width="3" />
        <path d="M12 30C22 24 30 34 36 42" stroke="#E3C88D" stroke-width="2" stroke-linecap="round" />
        <path d="M76 26C66 22 58 34 52 42" stroke="#E3C88D" stroke-width="2" stroke-linecap="round" />
        <line x1="22" y1="126" x2="66" y2="126" stroke="#E3C88D" stroke-width="2.5" stroke-dasharray="3 3" />
      </svg>

      <p style="font-family: var(--font-display); font-size: 1.25rem; color: var(--color-ivory-50); margin-bottom: 0.5rem;">
        Vertical Stage Composition Preserved
      </p>
      <p style="font-size: 0.82rem; color: var(--color-ivory-200); margin-bottom: 0.75rem; max-width: 32ch;">
        Full-length dancer in teal costume &amp; gold sash against dark stage. Hands, ghungroo, and silhouette kept intact (no landscape crop).
      </p>
      <div style="font-size: 0.74rem; background: rgba(0,0,0,0.45); padding: 0.5rem 0.75rem; border-radius: 4px; color: var(--color-gold-300);">
        Drive Preview ID: <code>{media.driveFileId}</code><br />
        <span>Hotlinking disabled by policy · Export local AVIF/WebP after identity &amp; photographer sign-off</span>
      </div>
    </div>

    <div style="font-size: 0.75rem; color: var(--color-ivory-200); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <span>{media.photographerCredit?.value}</span>
      {media.driveUrl && (
        <a
          href={media.driveUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="color: var(--color-gold-300); font-weight: 600;"
        >
          Inspect source file in Drive ↗
        </a>
      )}
    </div>
  </div>

  {media.caption && (
    <figcaption style="margin-top: 0.75rem; font-size: var(--text-xs); color: var(--color-charcoal-600); max-width: 440px; margin-inline: auto;">
      <EvidenceBadge tier={media.caption.tier} />
      <span style="display: block; margin-top: 0.35rem;">{media.caption.value}</span>
    </figcaption>
  )}
</figure>
