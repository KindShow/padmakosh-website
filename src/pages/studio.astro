---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClickToLoadYouTube from '../components/ClickToLoadYouTube.astro';
import type { YouTubeVideoAsset } from '../types/content';

const testimonialVideo: YouTubeVideoAsset = {
  id: 'yt-amruta-studio-praise',
  youtubeId: 't4W3TjxpATs',
  url: 'https://youtube.com/shorts/t4W3TjxpATs',
  title: 'A Soulful Praise for Our Soulful Space — Amruta Paranjape Gogate',
  sourceTitleInChannel: 'A soulful praise for our soulful space !',
  duration: '0:58',
  publishedDate: '2024',
  category: 'testimonial',
  credits: ['Kathak Artist: Amruta Paranjape Gogate', 'Padmakosh Studio, Bavdhan, Pune'],
  descriptionSummary:
    'Accomplished Kathak artist and fellow colleague Amruta Paranjape Gogate praises the serene ambiance, wooden flooring, and riyaaz atmosphere of Padmakosh Studio in Bavdhan.',
  embedVerified: true,
  captionsVerified: false,
  studentConsentPending: false,
  tier: 'verified',
  proposedPlacement: 'Padmakosh Studio Page Testimonial Section',
};
---

<BaseLayout
  title="Dance Studio in Bavdhan, Pune | Padmakosh Studio near Kothrud, Aundh, Pashan & Baner"
  description="Padmakosh Studio is a 750 sq. ft. air-conditioned dance and rehearsal studio in Bavdhan, Pune (serving Kothrud, Aundh, Pashan, Baner & Warje), equipped with wooden flooring, rehearsal mirrors, Wi-Fi, and video projection facilities."
  canonicalPath="/studio/"
>
  <!-- Studio Hero -->
  <section class="section" style="padding-bottom: 2.5rem;">
    <div class="container container--narrow" style="text-align: center;">
      <div style="margin-bottom: 1.5rem; display: flex; justify-content: center;">
        <img
          src="/images/logo/padmakosh_studio_logo_transparent.png"
          alt="Official Padmakosh Studio Logo"
          style="max-width: 280px; height: auto; display: block;"
        />
      </div>
      <span class="kicker kicker--dark">HOME TO PADMAKOSH SCHOOL OF KATHAK · BAVDHAN, PUNE</span>
      <h1 style="font-size: var(--text-hero); margin-bottom: 1.5rem; line-height: 1.05;">
        Padmakosh Studio
      </h1>
      <p style="font-size: var(--text-lg); line-height: 1.8; color: var(--text-primary); font-family: var(--font-display); max-width: 60ch; margin-inline: auto; margin-bottom: 1rem;">
        Padmakosh Studio is home to Padmakosh School of Kathak — a dedicated 750 sq. ft. creative sanctuary in Lohia Jain Square, Bavdhan, Pune, thoughtfully designed for physical and virtual Kathak training, choreographic development, intimate baithaks, and creative rehearsals.
      </p>
      <p style="font-size: 0.92rem; color: var(--text-muted); max-width: 56ch; margin-inline: auto; margin-bottom: 1.75rem;">
        Conveniently located in Bavdhan and serving nearby areas including Kothrud, Warje, Pashan, Aundh, and Baner.
      </p>

      <!-- Highlighted Associated Music Instructors Callout Higher in Body Section -->
      <div style="background: var(--bg-subtle); border: 1px solid rgba(212, 163, 89, 0.45); border-left: 4px solid var(--maroon-rich); padding: 1.25rem 1.5rem; border-radius: var(--radius-sm); text-align: left; max-width: 68ch; margin-inline: auto;">
        <p style="margin: 0; font-size: 0.92rem; line-height: 1.7; color: var(--text-primary);">
          <strong style="color: var(--maroon-rich); font-weight: 700;">Associated Music Instructors for Studio Events:</strong> Music-related events, classical baithaks, and accompaniment workshops hosted at Padmakosh Studio are conducted in association with music instructors <mark style="background: rgba(212, 163, 89, 0.25); color: var(--maroon-deep); font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 3px;">Shri. Anil Pendse</mark> and <mark style="background: rgba(212, 163, 89, 0.25); color: var(--maroon-deep); font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 3px;">Smt. Anjali Pendse</mark>.
        </p>
      </div>
    </div>
  </section>

  <!-- Photo Showcase: Genuine Padmakosh Studio Photography -->
  <section class="section" style="padding-block: 0 4rem;">
    <div class="container">
      <div class="grid-2" style="gap: 2rem;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/studio/studio_main_floor.jpg"
            alt="Padmakosh Studio interior wooden floor and Sanskrit calligraphy wall in Bavdhan, Pune"
            style="width: 100%; height: auto; max-height: 440px; object-fit: cover; display: block;"
          />
          <div style="padding: 1.25rem 1.5rem; background: var(--bg-subtle); border-top: 1px solid var(--border-light);">
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-dark); font-weight: 700; display: block;">
              PADMAKOSH STUDIO INTERIOR
            </span>
            <p style="font-family: var(--font-display); font-size: 1.15rem; margin: 0; color: var(--text-primary);">
              750 Sq. Ft. Wooden Practice Floor &amp; Sanskrit Calligraphy
            </p>
          </div>
        </div>

        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/studio/studio_mirrors.jpg"
            alt="Padmakosh Studio wall-to-wall rehearsal mirrors and lounge in Bavdhan"
            style="width: 100%; height: auto; max-height: 440px; object-fit: cover; display: block;"
          />
          <div style="padding: 1.25rem 1.5rem; background: var(--bg-subtle); border-top: 1px solid var(--border-light);">
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-dark); font-weight: 700; display: block;">
              REHEARSAL &amp; REFLECTION
            </span>
            <p style="font-family: var(--font-display); font-size: 1.15rem; margin: 0; color: var(--text-primary);">
              Wall-to-Wall Mirrors &amp; Comfortable Artist Lounge
            </p>
          </div>
        </div>

        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/studio/studio_workshop.jpg"
            alt="Padmakosh Studio workshop and lecture baithak in session"
            style="width: 100%; height: auto; max-height: 440px; object-fit: cover; display: block;"
          />
          <div style="padding: 1.25rem 1.5rem; background: var(--bg-subtle); border-top: 1px solid var(--border-light);">
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-dark); font-weight: 700; display: block;">
              WORKSHOPS &amp; BAITHAKS
            </span>
            <p style="font-family: var(--font-display); font-size: 1.15rem; margin: 0; color: var(--text-primary);">
              Interactive Lectures &amp; Digital Projection in Action
            </p>
          </div>
        </div>

        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/studio/studio_perspective.jpg"
            alt="Padmakosh Studio symmetrical classical rehearsal floor"
            style="width: 100%; height: auto; max-height: 440px; object-fit: cover; display: block;"
          />
          <div style="padding: 1.25rem 1.5rem; background: var(--bg-subtle); border-top: 1px solid var(--border-light);">
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--gold-dark); font-weight: 700; display: block;">
              CLASSICAL SANCTUARY
            </span>
            <p style="font-family: var(--font-display); font-size: 1.15rem; margin: 0; color: var(--text-primary);">
              Acoustic Space Designed for Mindful Riyaaz &amp; Artistry
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fellow Artist Testimonial Section -->
  <section class="section" style="padding-top: 0; padding-bottom: 3.5rem;">
    <div class="container">
      <div
        class="sleek-card"
        style="padding: 2.5rem; border-left: 4px solid var(--gold-warm); background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(212,163,89,0.05) 100%);"
      >
        <div class="grid-2" style="align-items: center; gap: 3.5rem;">
          <div>
            <span class="kicker kicker--dark" style="margin-bottom: 0.75rem;">
              FELLOW ARTIST TESTIMONIAL · PRAISE FOR PADMAKOSH STUDIO
            </span>
            <h2 style="font-size: var(--text-2xl); margin-bottom: 1rem; line-height: 1.2;">
              A Soulful Space for Classical Artistry
            </h2>
            <p style="font-size: 1rem; line-height: 1.8; color: var(--text-primary); margin-bottom: 1.5rem;">
              Accomplished Kathak artist and fellow colleague <strong>Amruta Paranjape Gogate</strong> shares her experience and admiration for Padmakosh Studio — celebrating its serene ambiance, dedicated wooden dance floor, and inspiring energy for riyaaz and creative exploration.
            </p>
            <div style="display: flex; align-items: center; gap: 1rem; border-top: 1px solid var(--border-light); padding-top: 1.25rem;">
              <div
                style="width: 46px; height: 46px; border-radius: 50%; background: var(--maroon-rich); color: #ffffff; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; flex-shrink: 0;"
              >
                A
              </div>
              <div>
                <strong style="display: block; font-size: 0.95rem; color: var(--text-primary);">Amruta Paranjape Gogate</strong>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Kathak Artist &amp; Colleague · Bavdhan Visit</span>
              </div>
            </div>
          </div>

          <div>
            <ClickToLoadYouTube video={testimonialVideo} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specs & Features -->
  <section class="section section--subtle">
    <div class="container">
      <div class="grid-2" style="gap: 4rem; align-items: start;">
        <div>
          <span class="kicker kicker--dark">SPECIFICATIONS</span>
          <h2 style="font-size: var(--text-2xl); margin-bottom: 1.5rem;">
            Space &amp; Facilities
          </h2>
          <div style="display: grid; gap: 1.25rem;">
            <div class="sleek-card" style="padding: 1.65rem;">
              <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--maroon-rich); display: block; margin-bottom: 0.35rem;">
                HYBRID &amp; DIGITAL INFRASTRUCTURE
              </span>
              <h3 style="font-size: 1.35rem; margin-bottom: 0.35rem;">High-Definition Video Projection &amp; Wi-Fi</h3>
              <p style="font-size: 0.88rem; margin-bottom: 0;">
                Equipped with video projection facilities and high-speed Wi-Fi — powering interactive virtual classes, choreography analysis, and hybrid workshops.
              </p>
            </div>

            <div class="sleek-card" style="padding: 1.65rem;">
              <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--gold-dark); display: block; margin-bottom: 0.35rem;">
                FLOOR DIMENSIONS
              </span>
              <h3 style="font-size: 1.35rem; margin-bottom: 0.35rem;">Approx. 750 Sq. Ft.</h3>
              <p style="font-size: 0.88rem; margin-bottom: 0;">Spacious floor suitable for solo presentations, annual show rehearsals, or ensemble choreography productions.</p>
            </div>

            <div class="sleek-card" style="padding: 1.65rem;">
              <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--gold-dark); display: block; margin-bottom: 0.35rem;">
                CLIMATE, AUDIO &amp; ACCESS
              </span>
              <h3 style="font-size: 1.35rem; margin-bottom: 0.35rem;">Air-Conditioned, Sound Equipped &amp; Parking</h3>
              <p style="font-size: 0.88rem; margin-bottom: 0;">Integrated audio system, acoustic comfort, and convenient parking access in Lohia Jain Square near NDA-Pashan Road.</p>
            </div>
          </div>
        </div>

        <div>
          <span class="kicker kicker--dark">USES, RENTALS &amp; OPPORTUNITIES</span>
          <h2 style="font-size: var(--text-2xl); margin-bottom: 1.5rem;">
            Creative Uses &amp; Studio Leadership
          </h2>
          <ul style="list-style: none; padding: 0; margin: 0 0 2.5rem 0; display: grid; gap: 1rem; font-size: 0.95rem;">
            <li style="border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
              <strong>Classical Dance Rehearsals, Solo Prep &amp; Masterclasses</strong>
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                Ideal for soloists, competition preparation, annual showcase rehearsals, and visiting guru workshops.
              </span>
            </li>
            <li style="border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
              <strong>Virtual &amp; Hybrid Learning Sessions</strong>
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                High-speed Wi-Fi and video projection support for global masterclasses and remote learning cohorts.
              </span>
            </li>
            <li style="border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
              <strong>Intimate Baithaks, Lecture-Demonstrations &amp; Shoots</strong>
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                Acoustic closeness for chamber performances, cultural photography, and performing arts documentation.
              </span>
            </li>
            <li style="padding-bottom: 0.5rem;">
              <strong>Studio Management &amp; Teacher’s Training Opportunities</strong>
              <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                Padmakosh offers dedicated working opportunities in studio management and teacher’s training for committed disciples.
              </span>
            </li>
          </ul>

          <div style="background: var(--bg-primary); border: 1px solid var(--border-light); padding: 2rem; border-radius: var(--radius-sm);">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Enquire for Studio Availability</h3>
            <p style="font-size: 0.88rem; margin-bottom: 1.5rem;">
              Space rentals, rehearsal slot bookings, and studio management enquiries in Bavdhan (conveniently accessible from Kothrud, Aundh, Pashan, Baner, and Warje) are confirmed upon review.
            </p>
            <a href="/contact/" class="btn btn--maroon" style="width: 100%;">
              ENQUIRE ABOUT STUDIO BOOKINGS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
