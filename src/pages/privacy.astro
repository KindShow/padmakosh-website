---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy | Padmakosh School of Kathak"
  description="Privacy practices for Padmakosh School of Kathak and Padmakosh Studio in Bavdhan, Pune."
  canonicalPath="/privacy/"
>
  <section class="section">
    <div class="container container--narrow">
      <span class="kicker kicker--dark">DATA &amp; PRIVACY</span>
      <h1 style="font-size: var(--text-hero); margin-bottom: 1.5rem; line-height: 1.05;">
        Privacy Notice
      </h1>
      <p style="font-size: var(--text-lg); line-height: 1.8; color: var(--text-primary); font-family: var(--font-display); margin-bottom: 3rem;">
        Padmakosh School of Kathak and Padmakosh Studio respect your privacy and handle student and enquiry data with utmost care.
      </p>

      <div style="display: grid; gap: 2.5rem; font-size: 0.95rem; line-height: 1.8;">
        <div>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.75rem;">1. Information We Collect</h2>
          <p>
            When you submit an admission or studio space enquiry, we collect only your name, contact information (email or phone number), chosen category, and message. We do not solicit or store sensitive personal information or financial documents through this website.
          </p>
        </div>

        <div>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.75rem;">2. Use of Information</h2>
          <p>
            Submitted details are used solely to reply to your question, assess class level placement, or coordinate studio bookings in Bavdhan, Pune. We never sell or distribute your contact details to third-party marketing entities.
          </p>
        </div>

        <div>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.75rem;">3. Embedded Media</h2>
          <p>
            Video players across this site use privacy-conscious click-to-load embeds on <code>youtube-nocookie.com</code>, ensuring third-party cookies are not placed until you choose to interact with a video.
          </p>
        </div>

        <div>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.75rem;">4. Contact</h2>
          <p>
            For any questions regarding privacy or to update your contact information, please email <a href="mailto:sonalpatil286@gmail.com" style="color: var(--maroon-rich); text-decoration: underline;">sonalpatil286@gmail.com</a>.
          </p>
        </div>

        <div style="padding-top: 1.5rem; border-top: 1px solid var(--border-light);">
          <h2 style="font-size: 1.4rem; margin-bottom: 0.75rem;">5. Institutional &amp; Event Faculty Disclosure</h2>
          <p style="margin-bottom: 0;">
            Padmakosh School of Kathak and Padmakosh Studio are directed by Sonal Pendse in Bavdhan, Pune. For music-related events, classical baithaks, and music workshops hosted at Padmakosh Studio, <mark style="background: rgba(212, 163, 89, 0.25); color: var(--maroon-deep); font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 3px;">Shri. Anil Pendse</mark> and <mark style="background: rgba(212, 163, 89, 0.25); color: var(--maroon-deep); font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 3px;">Smt. Anjali Pendse</mark> are associated with the studio as music instructors.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
