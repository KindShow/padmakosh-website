---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPadmakoshSiteData } from '../lib/sanity';
import ClickToLoadYouTube from '../components/ClickToLoadYouTube.astro';

const { artistProfile, classProgrammes, youtubeVideos } =
  await loadPadmakoshSiteData(new Date('2026-11-10T15:00:00+05:30'));

const introVideo = youtubeVideos.find((v) => v.youtubeId === 'QYmQGNO4dW8') || youtubeVideos[0];

const programStages = [
  {
    img: '/images/curated/program_stage1.jpg',
    label: 'Foundational Grammar & Alignment',
  },
  {
    img: '/images/curated/program_stage2.jpg',
    label: 'Taal Exploration & Board Certifications',
  },
  {
    img: '/images/curated/program_stage3.jpg',
    label: 'Solo Mastery & Professional Pathways',
  },
];

const questPillars = [
  {
    num: '01',
    title: 'Certification Exams Twice a Year',
    desc: 'Affiliated with Gandharva Mahavidyalaya and Bharati Vidyapeeth — offering worldwide-recognized Kathak certification exams twice annually.',
  },
  {
    num: '02',
    title: 'Annual Showcase Performances',
    desc: 'Performing opportunities in our curated annual shows, nurturing stage poise and expressive confidence for every learner.',
  },
  {
    num: '03',
    title: 'Solo Presentation Readiness',
    desc: 'Dedicated preparation for solo performances, prestigious national competitions, and original choreography productions.',
  },
  {
    num: '04',
    title: 'Commercial & Festival Stage Shows',
    desc: 'Regular performance opportunities in commercial and cultural productions upon attaining technical mastery.',
  },
  {
    num: '05',
    title: 'Teacher’s Training & Experience',
    desc: 'Structured pedagogical mentorship and practical teaching experience for senior disciples continuing the parampara.',
  },
  {
    num: '06',
    title: 'Studio Management Opportunities',
    desc: 'Hands-on working opportunities in studio management, event curation, and production coordination at Padmakosh Studio.',
  },
];

const homeFaqItems = [
  {
    q: 'Where is Padmakosh School of Kathak & Padmakosh Studio located in Pune?',
    a: 'Padmakosh Studio is located at Lohia Jain Square in Bavdhan, Pune (411021), with direct connectivity via NDA-Pashan Road and the Mumbai-Bangalore Highway — making it a convenient destination for students seeking Kathak classes and a professional dance studio near Bavdhan, Kothrud, Pashan, Aundh, Baner, and Warje.',
  },
  {
    q: 'Which examination boards is Padmakosh School of Kathak affiliated with?',
    a: 'We are affiliated with Akhil Bharatiya Gandharva Mahavidyalaya and Bharati Vidyapeeth for globally recognized Kathak certification examinations, which are conducted twice a year.',
  },
  {
    q: 'Are Kathak classes available for all age groups on weekdays, weekends, and online?',
    a: 'Yes. We offer personalized Kathak training modules for children, teenagers, and adults across weekday and weekend batches at our Bavdhan studio, as well as interactive online classes supported by high-speed Wi-Fi and full-wall video projection facilities.',
  },
  {
    q: 'Can Padmakosh Studio in Bavdhan be booked for dance rehearsals, workshops, and baithaks?',
    a: 'Yes. Padmakosh Studio features an approx. 750 sq. ft. air-conditioned dance floor with professional sound, full-wall video projection, and parking access in Bavdhan — ideal for classical rehearsals, workshops, and creative sessions for artists across Kothrud, Aundh, Pashan, and Baner.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title="Padmakosh School of Kathak | Kathak Classes & Dance Studio in Bavdhan, Kothrud, Aundh, Pashan & Baner, Pune"
  description="Looking for classical Kathak classes or a dance studio in Bavdhan, Kothrud, Aundh, Pashan, or Baner, Pune? Padmakosh School of Kathak offers weekday, weekend & online batches for all age groups, affiliated with Gandharva Mahavidyalaya & Bharati Vidyapeeth under Sonal Pendse."
  canonicalPath="/"
  structuredDataExtra={[faqJsonLd]}
>
  <!-- 1. Full-Bleed Theatrical Stage Hero -->
  <section class="hero-stage-full">
    <!-- Background Image Layer that fills the entire section -->
    <div class="hero-stage-bg" aria-hidden="true">
      <picture>
        <source media="(max-width: 768px)" srcset="/images/curated/hero_stage_sonal_mobile.jpg" />
        <img
          src="/images/curated/hero_stage_sonal_wide.jpg"
          alt="Kathak artist Sonal Pendse performing on stage"
          class="hero-stage-bg-img"
        />
      </picture>
      <div class="hero-theatrical-scrim"></div>
      <div class="hero-ambient-spotlight"></div>
    </div>

    <!-- Foreground Content Layer -->
    <div class="container hero-content-layer">
      <div class="hero-editorial-column">
        <div class="hero-kicker-badge">
          <span class="hero-kicker-text">BAVDHAN · PUNE, INDIA</span>
          <span class="hero-kicker-sep">/</span>
          <span class="hero-kicker-sub">GANDHARVA MAHAVIDYALAYA &amp; BHARATI VIDYAPEETH AFFILIATED</span>
        </div>

        <h1 class="hero-display-title">
          Where Heritage<br />
          <span class="italic-accent gold-accent">Inspires</span> Grace.
        </h1>

        <p class="hero-display-lead">
          Padmakosh School of Kathak bridges classical Banaras Gharana parampara with mindful riyaaz and stage artistry — offering personalized training for all age groups across weekday, weekend, and virtual batches under Sonal Pendse in Bavdhan, Pune.
        </p>

        <div class="hero-actions-cluster">
          <a href="/classes/" class="btn btn--gold">
            EXPLORE PROGRAMS
          </a>
          <a href="/studio/" class="btn btn--ghost-light">
            PADMAKOSH STUDIO
          </a>
        </div>

        <div class="hero-artist-credit">
          <span class="hero-artist-kicker">KATHAK ARTIST &amp; GURU</span>
          <span class="hero-artist-name">Sonal Pendse</span>
          <span class="hero-artist-lineage">Senior Disciple of Guru Shambhavi Dandekar · Bavdhan, Pune</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The Meaning of Padmakosh, Our Motto, Virtues & Hybrid Studio -->
  <section class="section" style="border-bottom: 1px solid var(--border-light); padding-block: clamp(4rem, 7vw, 6.5rem);">
    <div class="container">
      <div class="container--narrow" style="text-align: center; margin-inline: auto; margin-bottom: 4rem;">
        <span class="kicker kicker--dark">THE MEANING OF PADMAKOSH</span>
        <h2 style="font-size: clamp(1.85rem, 3.2vw, 2.7rem); font-weight: 400; line-height: 1.3; color: var(--text-primary); margin-bottom: 1.25rem;">
          “Padmakosh is inspired by a <em>hastamudra</em> that depicts a blooming lotus in Indian classical tradition — the timeless symbol of aesthetics, wealth, wisdom, and enlightenment.”
        </h2>
        <p style="font-size: var(--text-base); color: var(--text-muted); max-width: 62ch; margin-inline: auto; margin-bottom: 0;">
          Padmakosh Studio in Bavdhan, Pune is home to Padmakosh School of Kathak — serving nearby areas including Kothrud, Warje, Pashan, Aundh, and Baner, as well as global learners online.
        </p>
      </div>

      <div class="grid-3">
        <div class="sleek-card" style="border-top: 3px solid var(--maroon-rich);">
          <div>
            <span style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--maroon-rich); display: block; margin-bottom: 0.65rem;">
              OUR MOTTO
            </span>
            <h3 style="font-size: 1.35rem; margin-bottom: 0.75rem;">
              All Age Groups · Worldwide Recognition
            </h3>
            <p style="font-size: 0.9rem; line-height: 1.75; margin-bottom: 0;">
              We offer personalized modules of Kathak training for <strong>all age groups</strong> through <strong>weekday and weekend batches</strong> affiliated with <strong>Gandharva Mahavidyalaya</strong> and <strong>Bharati Vidyapeeth</strong>.
            </p>
          </div>
        </div>

        <div class="sleek-card" style="border-top: 3px solid var(--gold-warm);">
          <div>
            <span style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); display: block; margin-bottom: 0.65rem;">
              OUR VIRTUES
            </span>
            <h3 style="font-size: 1.35rem; margin-bottom: 0.75rem;">
              Personal Attention &amp; Strong Technique
            </h3>
            <p style="font-size: 0.9rem; line-height: 1.75; margin-bottom: 0;">
              <strong>Personal attention</strong>, <strong>disciplined teaching</strong>, and a <strong>versatile approach</strong> shape a dancer with strong technique and open the doors to immense possibilities on stage and beyond.
            </p>
          </div>
        </div>

        <div class="sleek-card" style="border-top: 3px solid var(--maroon-rich);">
          <div>
            <span style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--maroon-rich); display: block; margin-bottom: 0.65rem;">
              ONLINE &amp; IN-STUDIO CLASSES
            </span>
            <h3 style="font-size: 1.35rem; margin-bottom: 0.75rem;">
              Full-Wall Video Projection &amp; Wi-Fi
            </h3>
            <p style="font-size: 0.9rem; line-height: 1.75; margin-bottom: 0;">
              Alongside physical classes at our 750 sq. ft. Bavdhan studio, we offer interactive <strong>virtual classes</strong> supported by efficient Wi-Fi connectivity and <strong>full-wall video projection facilities</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Interactive Mudra & Repertoire Explorer -->
  <section class="section section--subtle">
    <div class="container">
      <div style="text-align: center; max-width: 650px; margin-inline: auto; margin-bottom: 3rem;">
        <span class="kicker kicker--dark">INTERACTIVE REPERTOIRE</span>
        <h2 style="font-size: var(--text-3xl); margin-bottom: 0.75rem;">Elements of Classical Kathak</h2>
        <p style="margin-bottom: 0; color: var(--text-muted);">
          Select an element below to inspect authentic stage postures, expressions, and mudras.
        </p>
      </div>

      <!-- Tab Buttons -->
      <div style="display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem;">
        <button type="button" class="interactive-tab-btn active" data-tab="tab-mudra">
          01. HASTA MUDRA (PADMAKOSH LOTUS)
        </button>
        <button type="button" class="interactive-tab-btn" data-tab="tab-abhinaya">
          02. ABHINAYA (EXPRESSION)
        </button>
        <button type="button" class="interactive-tab-btn" data-tab="tab-riyaaz">
          03. TAAL &amp; RIYAAZ (RHYTHM)
        </button>
        <button type="button" class="interactive-tab-btn" data-tab="tab-stage">
          04. SOLO &amp; STAGE PRODUCTIONS
        </button>
      </div>

      <!-- Tab Content 1: Mudra -->
      <div id="tab-mudra" class="tab-pane active grid-2" style="align-items: center; gap: 3.5rem;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/gallery/KAU_6227.jpg"
            alt="Kathak Hasta Mudra hand gestures"
            style="width: 100%; height: auto; max-height: 480px; object-fit: contain; background: #0a0608; display: block;"
          />
        </div>
        <div>
          <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
            THE BLOOMING LOTUS GESTURE
          </span>
          <h3 style="font-size: var(--text-2xl); margin-bottom: 1rem;">
            Padmakosh Hasta Mudra &amp; Anga Shuddhi
          </h3>
          <p style="font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem;">
            Named after the sacred <em>Padmakosh</em> mudra symbolizing a blooming lotus, our training begins with the geometry of the hands, wrists, and posture — translating Sanskrit verses and rhythmic syllables into living visual poetry.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: grid; gap: 0.6rem; font-size: 0.9rem;">
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Asamyuta (single-hand) and Samyuta (combined) mudra mastery</span></li>
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Geometric alignment with tatkar footwork and eye focus (Drishti Bheda)</span></li>
          </ul>
          <a href="/classes/" class="btn btn--maroon">EXPLORE BEGINNER BATCHES</a>
        </div>
      </div>

      <!-- Tab Content 2: Abhinaya -->
      <div id="tab-abhinaya" class="tab-pane grid-2" style="align-items: center; gap: 3.5rem;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/curated/sonal_abhinaya.jpg"
            alt="Kathak Abhinaya facial expression and emotional nuance"
            style="width: 100%; height: auto; max-height: 480px; object-fit: contain; background: #0a0608; display: block;"
          />
        </div>
        <div>
          <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
            EMOTIONAL STORYTELLING
          </span>
          <h3 style="font-size: var(--text-2xl); margin-bottom: 1rem;">
            Abhinaya &amp; Poetic Dialogue
          </h3>
          <p style="font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem;">
            Under Sonal Pendse’s guidance, abhinaya delves into the subtle nuances of bhava and rasa. Students learn to convey devotion, longing, and philosophical inquiry through glance, breath, and micro-expressions.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: grid; gap: 0.6rem; font-size: 0.9rem;">
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Interpretations of Meera bhajans, thumris, and traditional hori compositions</span></li>
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Integration of Sanskrit literature with expressive gestural language</span></li>
          </ul>
          <a href="/sonal-pendse/" class="btn btn--maroon">MEET GURU SONAL PENDSE</a>
        </div>
      </div>

      <!-- Tab Content 3: Taal & Riyaaz -->
      <div id="tab-riyaaz" class="tab-pane grid-2" style="align-items: center; gap: 3.5rem;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/curated/program_stage2.jpg"
            alt="Kathak Riyaaz and taal recitation"
            style="width: 100%; height: auto; max-height: 480px; object-fit: contain; background: #0a0608; display: block;"
          />
        </div>
        <div>
          <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
            MATHEMATICAL RIGOUR
          </span>
          <h3 style="font-size: var(--text-2xl); margin-bottom: 1rem;">
            Taal, Padhant &amp; Certified Exams
          </h3>
          <p style="font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem;">
            Padhant — the vocal recitation of bols — is the heartbeat of Kathak. Students internalize Tritaal, Jhaptal, and Pancham Sawari while preparing for twice-yearly examinations with Gandharva Mahavidyalaya and Bharati Vidyapeeth.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: grid; gap: 0.6rem; font-size: 0.9rem;">
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Toda, tukda, paran, and chakkar execution with rhythmic stability</span></li>
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Certification examinations conducted twice a year for global recognition</span></li>
          </ul>
          <a href="/classes/" class="btn btn--maroon">VIEW PROGRAM CURRICULUM</a>
        </div>
      </div>

      <!-- Tab Content 4: Stage Sadhana -->
      <div id="tab-stage" class="tab-pane grid-2" style="align-items: center; gap: 3.5rem;">
        <div style="border-radius: var(--radius-sm); overflow: hidden; background: #0c0809; box-shadow: 0 15px 35px -10px rgba(0,0,0,0.15);">
          <img
            src="/images/curated/grand_stage_performance.jpg"
            alt="Kathak live stage sadhana and ensemble performance"
            style="width: 100%; height: auto; max-height: 480px; object-fit: contain; background: #0a0608; display: block;"
          />
        </div>
        <div>
          <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
            DREAM OF THE SOLO PERFORMER
          </span>
          <h3 style="font-size: var(--text-2xl); margin-bottom: 1rem;">
            Competitions, Annual Shows &amp; Commercial Productions
          </h3>
          <p style="font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem;">
            Every dancer dreams to be a solo performer. Throughout the learning journey, students are introduced to prestigious competitions, annual showcase performances, choreography productions, and regular commercial shows after attaining mastery.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: grid; gap: 0.6rem; font-size: 0.9rem;">
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Dedicated solo presentation coaching and annual stage showcases</span></li>
            <li style="display: flex; gap: 0.5rem;"><span style="color: var(--maroon-rich);">—</span> <span>Pathways into commercial shows, teacher training, and studio leadership</span></li>
          </ul>
          <a href="/gallery/" class="btn btn--maroon">VIEW GALLERY ARCHIVE</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Our Ongoing Quest for Perfection (6 Pillars + Board Affiliations) -->
  <section class="section" style="border-bottom: 1px solid var(--border-light);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
          <span class="kicker kicker--dark">COMPLETE DANCER ECOSYSTEM</span>
          <h2 style="font-size: var(--text-3xl); margin-bottom: 0.5rem;">
            Our Ongoing Quest for Perfection
          </h2>
          <p style="margin-bottom: 0; max-width: 60ch; color: var(--text-muted);">
            Affiliated with <strong>Gandharva Mahavidyalaya</strong> and <strong>Bharati Vidyapeeth</strong>, our training opens six structured pathways from foundational certification to professional stage and teaching careers.
          </p>
        </div>
        <a href="/about/" class="btn btn--ghost" style="padding: 0.75rem 1.4rem;">
          OUR FULL PHILOSOPHY →
        </a>
      </div>

      <div class="grid-3">
        {questPillars.map((item) => (
          <div class="sleek-card">
            <div>
              <span style="font-family: var(--font-display); font-size: 1.65rem; font-weight: 600; color: var(--gold-dark); display: block; margin-bottom: 0.5rem;">
                {item.num}
              </span>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.65rem; color: var(--text-primary);">
                {item.title}
              </h3>
              <p style="font-size: 0.88rem; line-height: 1.7; margin-bottom: 0;">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Programs (Foundational, Intermediate, Advanced) -->
  <section class="section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3.5rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
          <span class="kicker kicker--dark">WEEKDAY, WEEKEND &amp; ONLINE BATCHES</span>
          <h2 style="font-size: var(--text-3xl); margin-bottom: 0.5rem;">Personalized Learning Modules</h2>
          <p style="margin-bottom: 0; max-width: 56ch; color: var(--text-muted);">
            Structured modules for all age groups — progressing from foundational posture and Tritaal recitation to certified board examinations and solo stage mastery.
          </p>
        </div>
        <a href="/classes/" class="btn btn--ghost" style="padding: 0.75rem 1.4rem;">
          VIEW FULL SYLLABUS →
        </a>
      </div>

      <div class="grid-3">
        {classProgrammes.map((prog, index) => (
          <div class="sleek-card" style="padding: 0; overflow: hidden;">
            <div style="position: relative; overflow: hidden; background: #0c0809;">
              <img
                src={programStages[index]?.img || '/images/curated/hero_stage_dancer.jpg'}
                alt={`${prog.title} - Kathak mudra and expression`}
                style="width: 100%; height: auto; max-height: 260px; object-fit: cover; display: block;"
              />
              <span style="position: absolute; top: 1rem; left: 1rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; background: rgba(0,0,0,0.8); color: var(--gold-light); padding: 0.25rem 0.65rem; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.15);">
                STAGE 0{index + 1}
              </span>
            </div>

            <div style="padding: 2rem; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
              <div>
                <h3 style="font-size: var(--text-xl); margin-bottom: 0.75rem; line-height: 1.25;">
                  {prog.title}
                </h3>
                <p style="font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.65;">
                  {prog.summary.value}
                </p>
              </div>

              <div style="border-top: 1px solid var(--border-light); padding-top: 1.25rem;">
                <a href="/contact/" style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--maroon-rich); display: inline-flex; align-items: center; gap: 0.4rem;">
                  ENQUIRE FOR BATCHES →
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Meet Sonal Pendse (Abhinaya Expression & Mudra Spotlight) -->
  <section class="section section--subtle">
    <div class="container">
      <div class="grid-2" style="align-items: center; gap: 4rem;">
        <div>
          <span class="kicker kicker--dark">THE ARTIST &amp; GURU</span>
          <h2 style="font-size: var(--text-3xl); margin-bottom: 1.25rem;">
            Sonal Pendse
          </h2>
          <p style="font-size: var(--text-lg); color: var(--text-primary); font-family: var(--font-display); line-height: 1.4; margin-bottom: 1.5rem;">
            Senior disciple of Guru Shambhavi Dandekar, blending classical rigour with evocative stage storytelling.
          </p>
          <p style="font-size: 0.95rem; line-height: 1.75; margin-bottom: 2rem;">
            {artistProfile.biographyIntro.value}
          </p>
          <div class="btn-group">
            <a href="/sonal-pendse/" class="btn btn--maroon">
              READ PROFILE &amp; REPERTOIRE
            </a>
          </div>
        </div>

        <div>
          <div style="border-radius: var(--radius-sm); overflow: hidden; box-shadow: 0 20px 45px -15px rgba(0,0,0,0.2); background: #0c0809;">
            <img
              src="/images/curated/sonal_abhinaya.jpg"
              alt="Sonal Pendse abhinaya expression and mudra in Kathak performance"
              style="width: 100%; height: auto; max-height: 520px; object-fit: contain; background: #080506; display: block;"
            />
