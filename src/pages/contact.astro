---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { SITE_SETTINGS_FIXTURE } from '../data/fixtures';
---

<BaseLayout
  title="Contact & Admissions | Padmakosh School of Kathak, Bavdhan, Pune"
  description="Contact Padmakosh School of Kathak and Padmakosh Studio in Bavdhan, Pune (serving Kothrud, Warje, Pashan, Aundh & Baner). Enquire about weekday, weekend, or online Kathak batches, certification exams, or studio bookings."
  canonicalPath="/contact/"
>
  <!-- Page Header -->
  <section class="section" style="padding-bottom: 2rem;">
    <div class="container container--narrow">
      <span class="kicker kicker--dark">GET IN TOUCH</span>
      <h1 style="font-size: var(--text-hero); margin-bottom: 1.5rem; line-height: 1.05;">
        Contact &amp; Admissions
      </h1>
      <p style="font-size: var(--text-lg); line-height: 1.8; color: var(--text-primary); font-family: var(--font-display);">
        Whether you are enrolling in weekday, weekend, or virtual Kathak batches for any age group, preparing for Gandharva Mahavidyalaya or Bharati Vidyapeeth certification exams, or enquiring about Padmakosh Studio in Bavdhan, Pune, we look forward to hearing from you.
      </p>
    </div>
  </section>

  <!-- Content Grid -->
  <section class="section section--subtle">
    <div class="container">
      <div class="grid-2" style="align-items: start; gap: 4rem;">
        <div>
          <EnquiryForm
            defaultCategory="kathak-classes"
            heading="Send an Enquiry"
            subheading="Share your age group, preferred batch (weekday, weekend, or online), or studio requirements below. We review every enquiry personally."
          />
        </div>

        <div style="display: grid; gap: 2rem;">
          <div class="sleek-card" style="border-left: 3px solid var(--maroon-rich);">
            <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
              INSTANT MESSAGING &amp; CALLS
            </span>
            <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">
              WhatsApp &amp; Phone
            </h2>
            <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 1.25rem;">
              For immediate batch queries, certification exam guidance, or studio rehearsal slot enquiries, connect directly on WhatsApp:
            </p>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <a
                href="https://wa.me/919689615339?text=Hello%20Padmakosh,%20I%20would%20like%20to%20enquire%20about%20Kathak%20classes%20and%20studio."
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--maroon"
                style="padding: 0.75rem 1.4rem; font-size: 0.75rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem;"
              >
                <svg width="20" height="20" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
                  <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                </svg>
                <span>CHAT ON WHATSAPP</span>
              </a>
              <a
                href="tel:+919689615339"
                class="btn btn--ghost"
                style="padding: 0.75rem 1.4rem; font-size: 0.75rem;"
              >
                CALL: +91 96896 15339
              </a>
            </div>
          </div>

          <div class="sleek-card">
            <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; color: var(--gold-dark); display: block; margin-bottom: 0.75rem;">
              STUDIO LOCATION &amp; MAP
            </span>
            <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">
              Bavdhan, Pune
            </h2>
            <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 0.75rem; color: var(--text-primary);">
              <strong>Padmakosh Studio</strong><br />
              B-501, Lohia Jain Square, S. No. 52/1B, Bavdhan,<br />
              Access NDA-Pashan Road, Behind Maratha Mandir,<br />
              Opposite Shinde Pump, Vaidehi Enclave,<br />
              Pune, Maharashtra 411021
            </p>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
              Serving nearby areas including Kothrud, Warje, Pashan, Aundh, and Baner.
            </p>

            <!-- Interactive Map Linked to Google Business Profile -->
            <div style="border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border-light); margin-bottom: 1.25rem; background: var(--bg-subtle);">
              <iframe
                title="Padmakosh Studio Location Map in Bavdhan, Pune"
                src="https://www.google.com/maps?q=Padmakosh+Studio+Lohia+Jain+Square+Bavdhan+Pune+411021&output=embed"
                width="100%"
                height="240"
                style="border: 0; display: block;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>

            <a
              href={SITE_SETTINGS_FIXTURE.socialLinks.googleBusinessProfile}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--ghost"
              style="width: 100%; font-size: 0.74rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>OPEN ON GOOGLE BUSINESS PROFILE &amp; MAPS ↗</span>
            </a>
          </div>

          <div class="sleek-card">
            <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; font-weight: 700; color: var(--maroon-rich); display: block; margin-bottom: 0.75rem;">
              EMAIL &amp; SOCIAL PROFILES
            </span>
            <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">
              Direct Communication
            </h2>
            <p style="font-size: 0.95rem; margin-bottom: 1.25rem;">
              <a href="mailto:sonalpatil286@gmail.com" style="color: var(--maroon-rich); font-weight: 600; text-decoration: underline;">
                sonalpatil286@gmail.com
              </a>
            </p>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
              Follow our latest performances, student showcases, and batch announcements:
            </p>

            <!-- Smart Social Icons on Contact Card -->
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <a
                href={SITE_SETTINGS_FIXTURE.socialLinks.instagramProfile}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-social-btn"
                aria-label="Follow Padmakosh on Instagram"
                title="Instagram"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </a>

              <a
                href={SITE_SETTINGS_FIXTURE.socialLinks.facebookProfile || 'https://www.facebook.com/padmakosh'}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-social-btn"
                aria-label="Follow Padmakosh on Facebook"
                title="Facebook"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>

              <a
                href={SITE_SETTINGS_FIXTURE.socialLinks.youtubeChannel}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-social-btn"
                aria-label="Watch Padmakosh on YouTube"
                title="YouTube"
              >
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
                </svg>
              </a>

              <a
                href={SITE_SETTINGS_FIXTURE.socialLinks.googleBusinessProfile}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-social-btn"
                aria-label="View Padmakosh on Google Maps & Business Profile"
                title="Google Business Profile"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--bg-subtle);
    border: 1px solid rgba(109, 21, 34, 0.22);
    color: var(--maroon-rich);
    transition: all 0.25s ease;
  }

  .contact-social-btn:hover {
    background: linear-gradient(135deg, #6d1b28 0%, #4a101b 100%);
    border-color: var(--gold-warm);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(109, 27, 40, 0.35);
  }
</style>
